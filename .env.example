# Application
# General process settings and default HTTP timeout.
APP_ENV=dev
LOG_LEVEL=INFO
HTTP_TIMEOUT=20s

# Runtime environment
# Shell/TLS runtime variables propagated into the app container.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# Database
# Application database connection pool and query timeouts.
DATABASE_URL=postgres://example_user:replace_me@postgres:5432/example_db?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_CONNECT_TIMEOUT=5s
DB_QUERY_TIMEOUT=5s

# Postgres container
# Postgres service bootstrap values used by docker compose.
POSTGRES_DB=example_db
POSTGRES_USER=example_user
POSTGRES_PASSWORD=replace_me

# VK API
# VK community token, API version, Long Poll, and message sending settings.
VK_GROUP_ID=100000001
VK_ACCESS_TOKEN=replace_me
VK_API_VERSION=5.199
VK_LONGPOLL_WAIT=25
VK_REQUEST_TIMEOUT=20s
VK_SEND_RANDOM_ID=0

# Manual commands
# Users allowed to run manual commands and the summary trigger text.
MANUAL_TRIGGER_USER_IDS=100000001,100000002
MANUAL_TRIGGER_COMMAND=/livanda

# Summary selection
# Message filtering, context limits, and automatic summary batch size.
SUMMARY_BATCH_SIZE=200
SUMMARY_MAX_CONTEXT_CHARS=12000
SUMMARY_MAX_CONTEXT_MESSAGES=200
SUMMARY_MIN_MESSAGE_LENGTH=3

# Text LLM
# OpenAI-compatible text generation provider and request tuning.
LLM_PROVIDER=stub
LLM_MODEL=stub-sarcasm-v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace_me
LLM_REQUEST_TIMEOUT=600s
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=2s
LLM_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=520
LLM_PROMPT_MAX_CHARS=12000

# Summary images
# Optional image generation provider and output size settings.
SUMMARY_IMAGE_ENABLED=false
SUMMARY_IMAGE_PROVIDER=cloudflare
SUMMARY_IMAGE_BASE_URL=https://api.cloudflare.com
SUMMARY_IMAGE_API_KEY=replace_me
SUMMARY_IMAGE_ACCOUNT_ID=replace_me
SUMMARY_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
SUMMARY_IMAGE_TIMEOUT=120s
SUMMARY_IMAGE_POLL_INTERVAL=3s
SUMMARY_IMAGE_WIDTH=1024
SUMMARY_IMAGE_HEIGHT=1024
SUMMARY_IMAGE_WIDTH_RATIO=1
SUMMARY_IMAGE_HEIGHT_RATIO=1
SUMMARY_IMAGE_FOLDER_ID=replace_me
SUMMARY_IMAGE_PROMPT_MAX_CHARS=1200
